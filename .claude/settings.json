{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_discard.py\"",
            "timeout": 10,
            "statusMessage": "Checking for discarded uncommitted changes"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(gh pr create --base master *)"
    ],
    "deny": [
      "Bash(git push *master*)",
      "Bash(git push *:*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * v*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)"
    ],
    "ask": [
      "Bash(gh pr merge * --merge)"
    ]
  }
}
